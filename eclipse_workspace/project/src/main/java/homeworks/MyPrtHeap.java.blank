  public String toString() {
    return strHelper(root, "", 1, new ArrayList<Node<K>>());
  }

  private String strHelper(Node<K> cur, String msg, int level,
      ArrayList<Node<K>> nodes) {
    if (cur == null) {
      return msg;
    }

    // if one of the children has been visited before then stop
    // avoids creating a cycle in intermediate steps
    nodes.add(cur);
    if (nodes.contains(cur.left) || nodes.contains(cur.right)) {
      msg = msg + "(cycle detected)\n";
      return msg;
    }

    msg = msg + "  ".repeat(level) + cur.key + "\n" +
      strHelper(cur.left, msg, level + 1, nodes) +
      strHelper(cur.right, msg, level + 1, nodes);
    return msg;
  }
}

